# ============================================================
# InjectFlow / AutomatizacionParametros
# .gitignore recomendado para GitHub
# ============================================================

# -----------------------------
# Python cache / compiled files
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -----------------------------
# Virtual environments
# -----------------------------
.venv/
.venv_build/
venv/
env/
ENV/

# -----------------------------
# Build / packaging
# -----------------------------
build/
dist/
*.exe
*.zip

# -----------------------------
# Runtime generated files
# -----------------------------
input/*
!input/.gitkeep

output/*
!output/.gitkeep

data/Historial.csv

# -----------------------------
# Generated diagnostics / logs
# -----------------------------
Plan_Escritura.csv
Reporte_Validacion.txt
*.log

# -----------------------------
# Temporary / backup files
# -----------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*
*.autosave

# -----------------------------
# Windows / macOS system files
# -----------------------------
Thumbs.db
Desktop.ini
.DS_Store

# -----------------------------
# IDE / editor metadata
# -----------------------------
.vscode/
.idea/

# -----------------------------
# Coverage / test artifacts
# -----------------------------
.coverage
htmlcov/
coverage.xml

# -----------------------------
# Python packaging metadata
# -----------------------------
*.egg-info/
.eggs/

# -----------------------------
# Keep source/release metadata
# Intentionally NOT ignored:
# app/
# data/Data.xlsx
# data/Mapeo.xlsx
# plantillas/
# web/
# tests/
# docs/
# requirements*.txt
# VERSION.txt
# LEEME*.txt
# InjectFlow.spec
# release_tools/
# -----------------------------
